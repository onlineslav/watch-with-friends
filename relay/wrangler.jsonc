{
  "name": "synced-video-relay",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-14",
  "vars": {
    // Private repository that receives development telemetry. The token that writes to it is a
    // secret: npx wrangler secret put DIAGNOSTICS_GITHUB_TOKEN
    "DIAGNOSTICS_REPO": "onlineslav/watch-with-friends-diagnostics"
  },
  // Live telemetry (relay/live.mjs): one Durable Object holds every WebSocket. SQLite-backed, which
  // is the only kind the free plan allows; it stores nothing.
  "durable_objects": {"bindings": [{"name": "LIVE", "class_name": "LiveHub"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["LiveHub"]}],
  "ratelimits": [{
    "name": "RATE_LIMITER",
    "namespace_id": "71004",
    "simple": {"limit": 10, "period": 60}
  }]
}
